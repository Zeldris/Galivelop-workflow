{
  "$schema": "gw/schema/gw.schema.json",
  "version": "0.5.2",
  "schemaVersion": 1,
  "language": "en",
  "visibleLanguages": [],
  "log": "docs/handoff.md",
  "logSize": 20000,
  "reviewTrivialLines": 30,
  "wholeReadWarnBytes": 20000,
  "logArchive": "docs/records/handoff-archive.md",
  "logRows": false,
  "protectedBranch": "main",
  "pushToProtected": "direct",
  "install": [],
  "setup": [],
  "check": ["make check", "python3 .claude/gw/scripts/agent-map.py", "python3 .claude/gw/scripts/tests-after-main.py"],
  "checkWrapper": "",
  "checkLockWait": 0,
  "checkReuseMark": true,
  "branchCheck": "related",
  "fullCheckPaths": ["^\\.githooks/", "^\\.claude/gw/", "^\\.claude/settings(\\.local)?\\.json$", "^\\.github/workflows/"],
  "fullCheckSkipKeys": ["reviewTrivialLines", "wholeReadWarnBytes", "stopTranscriptBytes", "stopSubagentMaxAge", "stopPushMarkerMaxAge", "stopGitTimeout", "stopSeverity", "recover", "hookStdinWait", "checkLockWait", "checkOutputGrace", "checkLogKeep", "ciFailedLines", "subagentCap", "subagentCapStep", "subagentCounterStaleDays", "subagentTranscriptBytes", "subagentCapAction", "contextGuard", "doctorTestDirsIgnore", "commitFormat", "commitRefs", "commitNext", "refsSources", "changeSize", "models", "metrics", "roadmapFiles", "commandTimeout", "commandKillGrace", "installLockfiles", "installLocal", "prepushClashBranches", "reviewBeforeMainListFiles", "checkTailLines", "releaseCheckBranches", "retro", "redWithoutFix", "branchPrefixes", "mergeCleanup", "wholeReadSkipExtensions", "wholeReadPaths", "harvest", "applyDiffLines", "ciGreenConclusions", "ciStatusTimeout", "ciStepTimeout", "ciSystemCommands", "doctorScanBytes", "patchCommitTypes", "measure", "mediaContent"],
  "ownedFiles": [],
  "checkCacheInputs": [".claude/gw.local.json"],
  "checkLogKeep": 20,
  "testJobs": 0,
  "stopTranscriptBytes": 4194304,
  "stopSubagentMaxAge": 86400,
  "stopPushMarkerMaxAge": 3600,
  "stopGitTimeout": 30,
  "stopSeverity": {"unpushed": "block", "logRequired": "block"},
  "recover": {"logLines": 25, "statusLines": 15, "worktrees": 10, "otherBranches": 10, "branchRow": 120, "worktreeRow": 200, "outputCap": 9500, "gitWait": 5, "searchMax": 10, "searchWidth": 300},
  "handoff": {"rowLimit": 600, "cellLimit": 800, "doneItems": 5},
  "harvest": {"ideaChars": 2000, "commitsShown": 30},
  "applyDiffLines": 80,
  "doctorScanBytes": 500000,
  "patchCommitTypes": ["fix", "hotfix", "perf"],
  "ciGreenConclusions": ["success", "neutral", "skipped"],
  "ciStatusTimeout": 0,
  "ciSystemCommands": ["sudo", "apt-get", "apt", "yum", "dnf", "apk", "brew", "choco", "winget", "snap"],
  "ciStepTimeout": 0,
  "staleRefsPaths": ["docs/", "README*"],
  "hookStdinWait": 3,
  "checkReuseTtl": 86400,
  "checkReuseKeep": 50,
  "checkOutputGrace": 5,
  "worktreeLinks": ["node_modules", ".venv"],
  "worktreeDir": "",
  "reviewMark": "docs/records/reviewed.txt",
  "requireRetro": false,
  "agentSignatures": true,
  "commitFormat": "free",
  "commitRefs": false,
  "commitNext": true,
  "commitTypes": ["feat", "fix", "hotfix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"],
  "commitWipPrefix": "WIP: ",
  "agentModelNames": [],
  "agentModelShapes": [],
  "agentSignaturePatterns": [],
  "refsSources": [],
  "keepLegacyPaths": false,
  "recordsDir": "docs/records",
  "proposalsDir": "docs/proposals",
  "ciLocalLog": "docs/records/ci-local.md",
  "ciLocalWorkflows": [],
  "ciNodeDirs": ["."],
  "ciRustDirs": [],
  "ciIgnore": [],
  "releaseDocs": [],
  "marketingSheets": {"sources": [], "outDir": "docs/mkt", "maxPages": 1, "css": "", "timeout": 120},
  "nonTestExtensions": ["md", "json", "yml", "yaml", "properties", "txt", "csv"],
  "ciKeepSteps": true,
  "ciOnPush": true,
  "ciFailedLines": 40,
  "legacyNames": true,
  "legacyNamesSkip": ["CHANGELOG*"],
  "legacyNamesMax": 50,
  "content": ["^docs/", "^(README|GLOSSARY|REVIEW|CLAUDE|AGENTS|CHANGELOG|CREDITS)(\\.[a-z]{2})?\\.md$", "^\\.claude/skills/.*\\.md$"],
  "roadmap": false,
  "roadmapFiles": [],
  "selector": {"cases": []},
  "logSections": [],
  "designReferences": [],
  "protectedPaths": [],
  "staleRefs": [],
  "linkRoots": [],
  "scoutDir": ".claude/gw/scout",
  "relatedTests": {"fast": [], "slow": []},
  "changeSize": {"commit": 400, "block": 1000, "severity": "warn"},
  "testMap": {"rules": [], "command": ""},
  "plan": [],
  "taskId": "[A-Z]{2,5}-\\d+",
  "subagentCap": 30,
  "subagentCapStep": 10,
  "subagentCounterStaleDays": 7,
  "subagentTranscriptBytes": 524288,
  "subagentCapAction": "ask",
  "commandTimeout": 900,
  "commandKillGrace": 5,
  "installLockfiles": ["package-lock.json", "*/package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "*/yarn.lock", "pnpm-lock.yaml", "*/pnpm-lock.yaml", "bun.lock", "bun.lockb", "*/bun.lock", "Cargo.lock", "*/Cargo.lock", "poetry.lock", "*/poetry.lock", "uv.lock", "*/uv.lock", "Pipfile.lock", "requirements*.txt", "*/requirements*.txt", "Gemfile.lock", "go.sum", "*/go.sum", "composer.lock", "pom.xml", "*/pom.xml"],
  "installLocal": false,
  "prepushClashBranches": 10,
  "reviewBeforeMainListFiles": 10,
  "checkTailLines": 40,
  "releaseCheckBranches": ["version/*"],
  "retro": {"filePattern": "(^|/)retro-[^/]*\\.md$", "statusMarker": "(Estado|Status)", "decidedWords": "aplicad[ao]s?|rechazad[ao]s?|aplazad[ao]s?|decidid[ao]s?|aprobad[ao]s?|applied|rejected|deferred|decided|approved", "pendingWords": "pendientes?|pending|undecided|sin decidir|aún no|not yet"},
  "redWithoutFix": {"compileRegex": "SyntaxError|IndentationError|ModuleNotFoundError|ImportError|ERROR collecting|error: could not compile|error\\[E[0-9]+\\]|error TS[0-9]+|Cannot find module|cannot find symbol|undefined reference|build failed|Failed to compile", "testRegex": "(def|fn|func|function)[[:space:]]+_?[Tt]est|(^|[^[:alnum:]_.])(it|test|describe)[[:space:]]*\\(|#\\[test\\]|@Test|unittest\\.TestCase|^[+@ -]*test_[A-Za-z0-9_]*[[:space:]]*\\(\\)"},
  "branchPrefixes": {"agent": ["worktree-agent-*", "agent/*"], "keep": ["claude/*"]},
  "mergeCleanup": true,
  "wholeReadSkipExtensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".ico", ".pdf", ".ipynb"],
  "wholeReadPaths": [],
  "models": {"disabled": []},
  "measure": {"minCalls": 5, "imageTokens": 1600, "mixedRatio": 1.5, "minOutput": 100, "coldMs": 100},
  "mediaContent": {"maxSubjects": 20},
  "testScanSkipDirs": [".git", "node_modules", ".venv", "venv", "__pycache__", ".tox"],
  "doctorTestDirsIgnore": [".git", "node_modules", ".claude/worktrees", ".claude/gw", "venv", ".venv", "env", ".tox", "site-packages", "__pycache__"],
  "instructionLines": {"warn": 150, "fail": 250},
  "contextGuard": {"cutoff": 0, "window": 200000, "autocompactShare": 0.8, "warn": 25, "alarm": 50, "charsPerToken": 3.5, "bigWindow": 1000000},
  "metrics": {"ledger": "docs/metrics/ledger.jsonl", "record": true, "gitTimeout": 30},
  "privateCheck": {"emails": true, "allowEmails": [], "maxHits": 10},
  "agentMap": {"prefixes": {}, "roots": []}
}
