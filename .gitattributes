# Scripts must keep LF line endings on every platform (Windows checkouts included).
*.sh text eol=lf
*.py text eol=lf
.githooks/* text eol=lf

# The token ledger (metrics.py, B2) only grows at the end: two branches that append to it merge by keeping both.
docs/metrics/ledger.jsonl merge=union

# Generated files do not count in the commit and block sizes (change-size.py, D43).
docs/mkt/**/*.html linguist-generated
docs/mkt/**/*.sha linguist-generated
docs/metrics/ledger.jsonl linguist-generated
