{
  "color": {
    "$type": "color",
    "bg": {"$value": "#ffffff"},
    "text": {"$value": "#1a1a2e"},
    "brand": {"$value": "#0b5fff"},
    "on-brand": {"$value": "#ffffff"}
  },
  "space": {
    "$type": "dimension",
    "1": {"$value": "4px"},
    "2": {"$value": "8px"},
    "3": {"$value": "16px"},
    "4": {"$value": "24px"}
  },
  "font": {
    "size": {
      "$type": "dimension",
      "base": {"$value": "1rem"},
      "large": {"$value": "1.5rem"}
    },
    "family": {"$type": "fontFamily", "body": {"$value": "system-ui, sans-serif"}}
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile": {"$value": "375px", "$extensions": {"gw": {"height": 740}}},
    "desktop": {"$value": "1280px"}
  }
}
