{
  "$schema": "../schema/gw.schema.json",
  "version": "0.1.0",
  "language": "es",
  "log": "docs/traspaso.md",
  "protectedBranch": "main",
  "pushToProtected": "direct",
  "install": [
    "pip install shellcheck-py"
  ],
  "check": [
    "bash tests/comprobar.sh",
    "[ \"${GW_PUSH_PROTECTED:-}\" != true ] || python3 scripts/version.py --release"
  ],
  "reviewMark": "docs/registros/revisado.txt",
  "content": [
    "^docs/",
    "^README(\\.es)?\\.md$",
    "^CHANGELOG\\.md$",
    "^CREDITS\\.md$",
    "^LICENSE"
  ],
  "staleRefs": [],
  "requireRetro": true
}
