{
  "$schema": "../schema/gw.schema.json",
  "version": "0.5.1",
  "schemaVersion": 1,
  "language": "es",
  "protectedBranch": "main",
  "pushToProtected": "direct",
  "install": [
    "pip install shellcheck-py"
  ],
  "check": [
    "bash tests/check.sh",
    "[ \"${GW_PUSH_PROTECTED:-}\" != true ] || python3 scripts/version.py --release"
  ],
  "content": [
    "^docs/",
    "^README(\\.es)?\\.md$",
    "^CHANGELOG\\.md$",
    "^CREDITS\\.md$",
    "^LICENSE"
  ],
  "staleRefs": [],
  "requireRetro": true,
  "releaseDocs": [
    "README.md",
    "README.es.md"
  ],
  "agentSignatures": false,
  "agentMap": {
    "path": "docs/agent-map.md"
  },
  "taskId": "[A-H]\\d+",
  "plan": [
    "docs/roadmap.md"
  ],
  "commitFormat": "conventional",
  "commitRefs": true,
  "commitNext": true,
  "refsSources": [
    "docs/roadmap.md",
    "docs/handoff.md"
  ],
  "privateCheck": {
    "allowEmails": [
      "cordproinf@gmail.com"
    ]
  },
  "marketingSheets": {
    "sources": [
      "docs/es/mkt-workflow.md",
      "docs/en/mkt-workflow.md",
      "docs/es/mkt-adoption.md",
      "docs/en/mkt-adoption.md"
    ],
    "outDir": "docs/mkt",
    "maxPages": 1,
    "css": "docs/mkt/style.css"
  },
  "changeSize": {
    "exclude": [
      "^\\.claude/gw/",
      "(^|/)(package-lock\\.json|npm-shrinkwrap\\.json|yarn\\.lock|pnpm-lock\\.yaml|poetry\\.lock|Pipfile\\.lock|uv\\.lock|Cargo\\.lock|Gemfile\\.lock|composer\\.lock|go\\.sum)$",
      "^\\.claude/skills/"
    ],
    "pairs": {
      "^docs/en/": "docs/es/",
      "^(.*)\\.en\\.md$": "\\1.md",
      "^README\\.md$": "README.es.md",
      "^templates/en/": "templates/es/"
    }
  },
  "testMap": {
    "rules": [
      {
        "paths": "^scripts/(?P<name>[^/]+)\\.(py|sh)$",
        "tests": [
          "tests/test_{name:id}.py"
        ]
      },
      {
        "paths": "^(scripts|templates/githooks)/",
        "tests": [
          "tests/test_reviewed.py",
          "tests/test_hooks.py"
        ]
      },
      {
        "paths": "^tests/(?P<name>[^/]+)\\.sh$",
        "tests": [
          "tests/test_{name:id}.py"
        ]
      },
      {
        "paths": "^tests/test_[^/]+\\.py$",
        "tests": [
          "{path}"
        ]
      },
      {
        "paths": "^tests/[^/]+\\.py$",
        "contains": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z0-9.-]+",
        "tests": [
          "tests/test_private_check.py"
        ]
      },
      {
        "paths": "^schema/",
        "tests": [
          "tests/test_config.py"
        ]
      },
      {
        "paths": "^\\.claude/skills/",
        "tests": [
          "tests/test_skills.py"
        ]
      },
      {
        "paths": "^templates/",
        "tests": [
          "tests/test_templates.py"
        ]
      }
    ],
    "command": "PYTHONPATH=tests python3 -B -m unittest {files}"
  }
}
