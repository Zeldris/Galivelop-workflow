{
  "$schema": "../schema/gw.schema.json",
  "version": "0.5.1",
  "schemaVersion": 1,
  "language": "es",
  "protectedBranch": "main",
  "pushToProtected": "direct",
  "install": [
    "pip install shellcheck-py"
  ],
  "check": [
    "bash tests/check.sh",
    "[ \"${GW_PUSH_PROTECTED:-}\" != true ] || python3 scripts/version.py --release"
  ],
  "content": [
    "^docs/",
    "^README(\\.es)?\\.md$",
    "^CHANGELOG\\.md$",
    "^CREDITS\\.md$",
    "^LICENSE"
  ],
  "staleRefs": [],
  "requireRetro": true,
  "releaseDocs": [
    "README.md",
    "README.es.md"
  ],
  "agentSignatures": false,
  "agentMap": {
    "path": "docs/agent-map.md"
  },
  "taskId": "[A-H]\\d+",
  "commitFormat": "conventional",
  "commitRefs": true,
  "commitNext": true,
  "refsSources": [
    "docs/roadmap.md",
    "docs/handoff.md"
  ],
  "privateCheck": {
    "allowEmails": [
      "cordproinf@gmail.com"
    ]
  },
  "marketingSheets": {
    "sources": [
      "docs/es/mkt-workflow.md",
      "docs/en/mkt-workflow.md",
      "docs/es/mkt-adoption.md",
      "docs/en/mkt-adoption.md"
    ],
    "outDir": "docs/mkt",
    "maxPages": 1,
    "css": "docs/mkt/style.css"
  }
}
