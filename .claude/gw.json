{
  "$schema": "../schema/gw.schema.json",
  "version": "0.4.3",
  "schemaVersion": 1,
  "language": "es",
  "protectedBranch": "main",
  "pushToProtected": "direct",
  "install": [
    "pip install shellcheck-py"
  ],
  "check": [
    "bash tests/check.sh",
    "[ \"${GW_PUSH_PROTECTED:-}\" != true ] || python3 scripts/version.py --release"
  ],
  "content": [
    "^docs/",
    "^README(\\.es)?\\.md$",
    "^CHANGELOG\\.md$",
    "^CREDITS\\.md$",
    "^LICENSE"
  ],
  "staleRefs": [],
  "requireRetro": true,
  "agentSignatures": false,
  "agentMap": {
    "path": "docs/agent-map.md"
  },
  "taskId": "[A-H]\\d+",
  "commitFormat": "conventional",
  "commitRefs": true,
  "refsSources": [
    "docs/roadmap.md",
    "docs/handoff.md"
  ],
  "privateCheck": {
    "allowEmails": [
      "cordproinf@gmail.com"
    ]
  }
}
